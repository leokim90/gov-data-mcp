# data.go.kr 통합 인증키 (중기부·정부24·나라장터 공통)
# 발급: https://www.data.go.kr/ → 마이페이지 → 활용신청 → 일반 인증키(Encoding) 사용
DATA_GO_KR_SERVICE_KEY=

# 기업마당 (bizinfo.go.kr) 인증키
# 발급: https://www.bizinfo.go.kr/ → 회원가입 → 마이페이지 → API 신청
BIZINFO_API_KEY=

# 중소벤처24 (smes.go.kr) 토큰
# 발급: https://www.smes.go.kr/ → 회원가입 → 마이페이지 → API 토큰 신청
SMES_API_KEY=

# --- HTTP 모드(원격 배포) 전용 ---
# 관리자 토큰 (기존 방식, 'default' 라벨로 집계) — 생성: openssl rand -hex 24
AUTH_TOKEN=
# 부서별 토큰 (선택, "라벨:토큰" 콤마 구분) — 부서별 발급/회수 + /healthz 라벨별 사용량 집계
# 예: AUTH_TOKENS=finance:a1b2c3...,sales:d4e5f6...
# AUTH_TOKEN·AUTH_TOKENS 둘 다 없으면 기동 거부 (무인증 공개 방지)
AUTH_TOKENS=
# HTTP 포트 (기본 8787)
PORT=
