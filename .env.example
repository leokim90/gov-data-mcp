# data.go.kr 통합 인증키 (중기부·정부24·나라장터 공통)
# 발급: https://www.data.go.kr/ → 마이페이지 → 활용신청 → 일반 인증키(Encoding) 사용
DATA_GO_KR_SERVICE_KEY=

# 기업마당 (bizinfo.go.kr) 인증키
# 발급: https://www.bizinfo.go.kr/ → 회원가입 → 마이페이지 → API 신청
BIZINFO_API_KEY=

# 중소벤처24 (smes.go.kr) 토큰
# 발급: https://www.smes.go.kr/ → 회원가입 → 마이페이지 → API 토큰 신청
SMES_API_KEY=

# --- HTTP 모드(원격 배포) 전용 ---
# 인증 토큰 (필수, 미설정 시 http-server 기동 거부) — 생성: openssl rand -hex 24
AUTH_TOKEN=
# HTTP 포트 (기본 8787)
PORT=
